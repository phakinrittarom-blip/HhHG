-- สลับ เปิด/ปิด หน้าต่าง
ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

CloseBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
end)

local function updateStatus()
    local count = 0
    for _, v in pairs(selectedTargets) do
        if v then count = count + 1 end
    end
    StatusLabel.Text = "Flinging " .. tostring(count) .. " target(s)"
end

-- อัปเดตรายชื่อผู้เล่นในหน้าต่าง
local function refreshPlayerList()
    for _, child in pairs(PlayerScroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local ItemFrame = Instance.new("Frame")
            ItemFrame.Name = player.Name
            ItemFrame.Size = UDim2.new(1, -6, 0, 30)
            ItemFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            ItemFrame.BorderSizePixel = 0
            ItemFrame.Parent = PlayerScroll

            local CheckBox = Instance.new("TextButton")
            CheckBox.Size = UDim2.new(0, 20, 0, 20)
            CheckBox.Position = UDim2.new(0, 5, 0.5, -10)
            CheckBox.BackgroundColor3 = selectedTargets[player.Name] and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(50, 50, 50)
            CheckBox.Text = selectedTargets[player.Name] and "✓" or ""
            CheckBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            CheckBox.Parent = ItemFrame

            local NameLabel = Instance.new("TextLabel")
            NameLabel.Size = UDim2.new(1, -35, 1, 0)
            NameLabel.Position = UDim2.new(0, 32, 0, 0)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Text = player.Name
            NameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
            NameLabel.Font = Enum.Font.SourceSans
            NameLabel.TextSize = 14
            NameLabel.TextXAlignment = Enum.TextXAlignment.Left
            NameLabel.Parent = ItemFrame

            CheckBox.MouseButton1Click:Connect(function()
                selectedTargets[player.Name] = not selectedTargets[player.Name]
                CheckBox.BackgroundColor3 = selectedTargets[player.Name] and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(50, 50, 50)
                CheckBox.Text = selectedTargets[player.Name] and "✓" or ""
                updateStatus()
            end)
        end
    end
    PlayerScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(function(player)
    selectedTargets[player.Name] = nil
    refreshPlayerList()
    updateStatus()
end)

SelectAllBtn.MouseButton1Click:Connect(function()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            selectedTargets[player.Name] = true
        end
    end
    refreshPlayerList()
    updateStatus()
end)

DeselectAllBtn.MouseButton1Click:Connect(function()
    selectedTargets = {}
    refreshPlayerList()
    updateStatus()
end)

-------------------------------------------------
-- 5. ระบบ Fling Physics
-------------------------------------------------
StartBtn.MouseButton1Click:Connect(function()
    if isFlinging then return end
    isFlinging = true
    
    flingConnection = RunService.Heartbeat:Connect(function()
        if not isFlinging then return end
        
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        
        for name, selected in pairs(selectedTargets) do
            if selected then
                local targetPlayer = Players:FindFirstChild(name)
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local targetRoot = targetPlayer.Character.HumanoidRootPart
                    
                    -- Fling Mechanics (หมุนตัวความเร็วสูงแล้ววาปไปหาเป้าหมาย)
                    myRoot.CFrame = targetRoot.CFrame
                    myRoot.Velocity = Vector3.new(10000, 10000, 10000)
                    myRoot.RotVelocity = Vector3.new(10000, 10000, 10000)
                end
            end
        end
    end)
end)

StopBtn.MouseButton1Click:Connect(function()
    isFlinging = false
    if flingConnection then
        flingConnection:Disconnect()
        flingConnection = nil
    end
    
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if myRoot then
        myRoot.Velocity = Vector3.new(0, 0, 0)
        myRoot.RotVelocity = Vector3.new(0, 0, 0)
    end
end)

refreshPlayerList()
