-- ระบบจัดการรายชื่อผู้เล่น & Fling Logic
local SelectedPlayers = {}
local IsFlinging = false
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function UpdateCount()
    local count = 0
    for _, selected in pairs(SelectedPlayers) do
        if selected then count = count + 1 end
    end
    StatusLabel.Text = "Flinging " .. tostring(count) .. " target(s)"
end

local function RefreshPlayerList()
    for _, child in pairs(PlayerList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local Item = Instance.new("Frame")
            Item.Size = UDim2.new(1, -5, 0, 30)
            Item.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            Item.Parent = PlayerList
            
            local Checkbox = Instance.new("TextButton")
            Checkbox.Size = UDim2.new(0, 20, 0, 20)
            Checkbox.Position = UDim2.new(0, 5, 0.5, -10)
            Checkbox.BackgroundColor3 = SelectedPlayers[player.Name] and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(60, 60, 60)
            Checkbox.Text = SelectedPlayers[player.Name] and "✓" or ""
            Checkbox.TextColor3 = Color3.fromRGB(255, 255, 255)
            Checkbox.Parent = Item
            
            local NameLabel = Instance.new("TextLabel")
            NameLabel.Size = UDim2.new(1, -35, 1, 0)
            NameLabel.Position = UDim2.new(0, 30, 0, 0)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Text = player.Name
            NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            NameLabel.TextXAlignment = Enum.TextXAlignment.Left
            NameLabel.Parent = Item
            
            local function ToggleSelect()
                SelectedPlayers[player.Name] = not SelectedPlayers[player.Name]
                Checkbox.BackgroundColor3 = SelectedPlayers[player.Name] and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(60, 60, 60)
                Checkbox.Text = SelectedPlayers[player.Name] and "✓" or ""
                UpdateCount()
            end
            
            Checkbox.MouseButton1Click:Connect(ToggleSelect)
        end
    end
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

Players.PlayerAdded:Connect(RefreshPlayerList)
Players.PlayerRemoving:Connect(function(plr)
    SelectedPlayers[plr.Name] = nil
    RefreshPlayerList()
    UpdateCount()
end)

SelectAllButton.MouseButton1Click:Connect(function()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then SelectedPlayers[plr.Name] = true end
    end
    RefreshPlayerList()
    UpdateCount()
end)

DeselectAllButton.MouseButton1Click:Connect(function()
    SelectedPlayers = {}
    RefreshPlayerList()
    UpdateCount()
end)

-- ระบบ Fling Loop
task.spawn(function()
    while true do
        task.wait()
        if IsFlinging then
            for targetName, isSelected in pairs(SelectedPlayers) do
                if isSelected and IsFlinging then
                    local targetPlayer = Players:FindFirstChild(targetName)
                    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local myHRP = LocalPlayer.Character.HumanoidRootPart
                        local targetHRP = targetPlayer.Character.HumanoidRootPart
                        
                        -- Fling Logic (หมุนด้วยความเร็วสูง)
                        local vel = myHRP.Velocity
                        myHRP.Velocity = Vector3.new(10000, 10000, 10000)
                        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 0)
                        task.wait(0.05)
                        myHRP.Velocity = vel
                    end
                end
            end
        end
    end
end)

StartButton.MouseButton1Click:Connect(function()
    IsFlinging = true
end)

StopButton.MouseButton1Click:Connect(function()
    IsFlinging = false
end)

RefreshPlayerList()
